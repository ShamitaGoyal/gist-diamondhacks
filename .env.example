# Copy this file to `.env` in the repo root and fill in values.
# `.env` is gitignored — never commit real keys.

# Required for Gist Lens (frontend) and legacy `/analyze`: Google AI Studio API key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=key

# Optional: model + fallbacks (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.0-flash,gemini-2.5-flash

# Gemini 3.x thinking: minimal | low | medium | high (default low for RAG/chat)
# GEMINI_THINKING_LEVEL=low

# RAG retrieval (all-MiniLM-L6-v2; scores often 0.55–0.70 on papers)
# RAG_MIN_SIMILARITY=0.55
# RAG_FALLBACK_MIN_BEST=0.45
