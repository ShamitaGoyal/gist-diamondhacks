# Google AI Studio / Vertex — never commit real keys
GEMINI_API_KEY=

# Default: gemini-1.5-flash (often friendlier free-tier limits than 2.0)
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# Pacing for free tier (server-side)
# GEMINI_MAX_REQUESTS_PER_MINUTE=5
# GEMINI_MIN_INTERVAL_MS=12000
# GEMINI_VISUAL_CACHE_TTL_MS=600000
# GEMINI_STORY_CACHE_TTL_MS=900000

# API server port (default: 8787)
# PAPERSCOPE_API_PORT=8787

# Frontend: set only if the API is not proxied under the same origin
# VITE_API_BASE_URL=http://127.0.0.1:8787
